# whalemail configuration. Copy to .env and fill in the values (.env is git-ignored).

# ── Classification LLM (any OpenAI-compatible chat endpoint) ───────────────
WHALEMAIL_LLM_API_KEY=
WHALEMAIL_LLM_BASE_URL=https://openrouter.ai/api/v1
WHALEMAIL_CLASSIFY_MODEL=deepseek/deepseek-v4-flash
# Optional: a different model for the agent (defaults to the classification model)
# WHALEMAIL_AGENT_MODEL=

# ── Gmail API ──────────────────────────────────────────────────────────────
# Path to the Desktop OAuth client JSON downloaded from Google Cloud, and where the token is cached
WHALEMAIL_GMAIL_CLIENT_SECRET=config/client_secret.json
WHALEMAIL_GMAIL_TOKEN=config/token.json
# The Gmail address being triaged
WHALEMAIL_GMAIL_ACCOUNT=you@gmail.com

# ── Telegram ───────────────────────────────────────────────────────────────
# Bot token from @BotFather. The bot must be a member of the group it posts to.
WHALEMAIL_BOT_TOKEN=
# Group chat id (-100...). For a forum topic, also set the thread id:
#   https://t.me/c/<A>/<B>/<C>  →  WHALEMAIL_TG_CHANNEL=-100<A>, WHALEMAIL_TG_THREAD=<B>
WHALEMAIL_TG_CHANNEL=
WHALEMAIL_TG_THREAD=

# ── Language, owner, timezone, schedule ────────────────────────────────────
# Language of Telegram messages and LLM output: en or zh
WHALEMAIL_LANGUAGE=en
# How the agent refers to you in its prompt (optional)
WHALEMAIL_OWNER_NAME=
# IANA timezone for timestamps and the active window
WHALEMAIL_TZ=UTC
# Active window: 🔴 alerts are pushed as they arrive; outside it everything waits for the digest
WHALEMAIL_ACTIVE_START=7
WHALEMAIL_ACTIVE_END=23
# Scheduler parameters (--once interval in minutes / heartbeat interval in hours / digest hour).
# After changing any of these, re-run scripts/install-whalemail-launchd.sh.
WHALEMAIL_ONCE_STEP_MIN=10
WHALEMAIL_HEARTBEAT_EVERY=2
WHALEMAIL_DIGEST_HOUR=7
